{
  "name": "recipenestvault",
  "version": "0.1.0",
  "private": true,
  "description": "Static-first multilingual recipe discovery site for Cloudflare Pages",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "images": "node scripts/images.mjs",
    "icons": "node scripts/icons.mjs",
    "manifest:korean-illustrations": "node scripts/generate-korean-illustration-sets.mjs",
    "manifest:thai-illustrations": "node scripts/generate-thai-illustration-sets.mjs",
    "manifest:taiwanese-illustrations": "node scripts/generate-taiwanese-illustration-sets.mjs",
    "build": "node scripts/build.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:japanese-drafts": "node scripts/audit-japanese-drafts.mjs",
    "audit:korean-drafts": "node scripts/audit-korean-drafts.mjs",
    "audit:thai-drafts": "node scripts/audit-thai-drafts.mjs",
    "audit:taiwanese-drafts": "node scripts/audit-taiwanese-drafts.mjs",
    "qa:visual": "node scripts/qa-visual.mjs",
    "test": "npm run audit:japanese-drafts && npm run audit:korean-drafts && npm run audit:thai-drafts && npm run audit:taiwanese-drafts && npm run build && npm run audit",
    "deploy": "npm run test && wrangler pages deploy dist --project-name recipenestvault --branch main"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "wrangler": "4.127.0"
  },
  "engines": {
    "node": ">=20"
  }
}
